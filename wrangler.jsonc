{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dining-philosophers",
  "main": "src/index.js",
  "compatibility_date": "2026-08-18",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "DINING_ROOM",
        "class_name": "DiningPhilosophersRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DiningPhilosophersRoom"]
    }
  ]
}
